# Copy to Cluster/kubeconfig and fill it in.
# Use a ServiceAccount token with minimal RBAC, never an admin certificate.
apiVersion: v1
kind: Config
clusters:
  - name: my-cluster
    cluster:
      server: https://<API_SERVER>:6443
      certificate-authority-data: <BASE64_CA>
users:
  - name: macon-agent
    user:
      token: <SERVICEACCOUNT_TOKEN>
contexts:
  - name: my-cluster
    context: { cluster: my-cluster, user: macon-agent }
current-context: my-cluster
