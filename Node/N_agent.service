[Unit]
Description=Node Agent Deamon
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/runner/augmenta/agent/node_agent.py
Restart=always
User=runner
WorkingDirectory=/home/runner/augmenta/agent
StandardOutput=file:/var/log/node_agent_daemon.log
StandardError=file:/var/log/node_agent_daemon.err
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
